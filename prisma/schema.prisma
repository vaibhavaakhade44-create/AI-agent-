// Prisma schema for AI Agent Persistent Memory & Logging
// Uses PostgreSQL as requested by the architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 🗄️ Memory Table (Aathvani thevnyasathi)
model Memory {
  id        Int      @id @default(autoincrement())
  topic     String   // e.g., "Clinic Project Folder"
  content   String   // e.g., "D:/Projects/Clinic"
  createdAt DateTime @default(now())

  @@index([topic])
}

// 💬 Conversation History (Chat logs)
model Conversation {
  id        Int      @id @default(autoincrement())
  sender    String   // "User" kiva "Jarvis"
  message   String
  timestamp DateTime @default(now())

  @@index([sender, timestamp])
}

// 🔍 Observer System Alerts
model SystemAlert {
  id        Int      @id @default(autoincrement())
  type      String   // 'battery', 'cpu', 'memory', 'disk', 'error'
  level     String   // 'info', 'warning', 'critical'
  metric    Float?   // e.g. 92.5 (%)
  message   String
  createdAt DateTime @default(now())

  @@index([type, level])
}
