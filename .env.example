# ============================================
# AI AGENT CONFIGURATION
# ============================================

# 1. TELEGRAM APP SETTINGS (Mobile Ear & Reply)
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Optional default chat ID to send auto-alerts to
TELEGRAM_DEFAULT_CHAT_ID=""

# 2. THE BRAIN: OLLAMA SETTINGS
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# 3. MEMORY: POSTGRESQL + PRISMA
# Syntax: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:TujhaPasswordItheTak@localhost:5432/jarvis_memory?schema=public"

# 4. OBSERVER (BACKGROUND SYSTEM MONITOR)
# Interval in seconds to check battery, cpu, disk
OBSERVER_CHECK_INTERVAL_SECONDS=30
CPU_ALERT_THRESHOLD_PERCENT=85
RAM_ALERT_THRESHOLD_PERCENT=90
BATTERY_LOW_THRESHOLD_PERCENT=20

# 5. LAPTOP SPEAKER (TTS)
SPEAKER_ENABLED=true
SPEAKER_RATE=0
SPEAKER_VOLUME=100
